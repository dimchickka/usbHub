{
    "cmake.sourceDirectory": "${workspaceFolder}/gd32_fw",
    "cmake.buildDirectory": "${workspaceFolder}/build/gd32",
    "cmake.configureSettings": {
        "CMAKE_TOOLCHAIN_FILE": "${workspaceFolder}/gd32_fw/cmake/arm-none-eabi.cmake",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
    },
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/gd32/compile_commands.json",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/gd32_fw/Core/inc",
        "${workspaceFolder}/gd32_fw/external/GD32F4xx_Firmware_Library/Firmware/CMSIS",
        "${workspaceFolder}/gd32_fw/external/GD32F4xx_Firmware_Library/Firmware/CMSIS/GD/GD32F4xx/Include",
        "${workspaceFolder}/gd32_fw/external/GD32F4xx_Firmware_Library/Firmware/GD32F4xx_standard_peripheral/Include",
        "${workspaceFolder}/gd32_fw/external/FreeRTOS-Kernel/include",
        "${workspaceFolder}/gd32_fw/external/FreeRTOS-Kernel/portable/GCC/ARM_CM4F"
    ],
    "C_Cpp.default.defines": ["GD32F470", "HXTAL_VALUE=12000000"]
}
